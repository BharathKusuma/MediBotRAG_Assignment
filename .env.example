# MediBot Environment Configuration

# Optional: Add any available cloud LLM API key below.
# MediBot will automatically prioritize Gemini -> Groq -> OpenAI -> local synthesis fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# LLM Provider selection: auto, gemini, groq, openai, mock
LLM_PROVIDER=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000
